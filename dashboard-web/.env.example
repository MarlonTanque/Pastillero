# Copiar como .env.local (excluido de Git) con la configuración web pública del proyecto pastillerobadi.
# Sin VITE_FIREBASE_API_KEY el dashboard abre en modo demostración con datos ficticios.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pastillerobadi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pastillerobadi
VITE_FIREBASE_APP_ID=
