                },
                "reason": {
                  ".validate": "newData.val() === 'OK' || newData.val() === 'EXPIRED_OR_INVALID_TIME' || newData.val() === 'INVALID_REVISION' || newData.val() === 'UNKNOWN_COMMAND'"
                },
                "requestedAt": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0"
                },
                "executedAt": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= newData.parent().child('requestedAt').val() - 60000 && newData.val() <= now + 60000"
                },
                "planRevision": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() < 2000000000"
                },
                "simulation": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "access": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
