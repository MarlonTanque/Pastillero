// ============================================================
// 9. SETUP: INICIALIZACION UNA SOLA VEZ
// ============================================================
// Inicializa consola, geometría, periféricos permitidos, recuperación local y tarea de red una sola vez.
void setup() {
    Serial.begin(115200);
    controlador.geometry(DEFAULT_POSITIONS);
    configurarMotorYSensores();
    restaurarMemoriaPersistente();
    prepararColasYRed();
    Serial.println(
        "a/r: +/-10 pasos; c: confirmar cero; s: secuencia 1,2,3,4 y regreso a cero. SIMULACION por defecto.");
}


// ============================================================
// 10. LOOP: CICLO NO BLOQUEANTE
// ============================================================
// Atiende un paso del motor, mensajes seguros, calibración, dosis e indicadores sin esperar por la nube.
void loop() {
#if !PASTILLERO_DRY_RUN
    // Lectura: Genera el siguiente paso cuando corresponde; debe llamarse con frecuencia para
    // respetar velocidad y Lectura: aceleración.
    motor.run();
#endif
    // Lectura: Captura tiempo desde el arranque para intervalos; nunca se compara directamente con
    // una fecha Unix.
    uint32_t ms = millis();
    // Guardar en flash y recibir planes solo con el motor detenido evita interrumpir los pulsos.
    bool sincronizacionSegura =
        controlador.state == pill::State::Idle || controlador.state == pill::State::Awaiting ||
        controlador.state == pill::State::Alert || controlador.state == pill::State::Fault;
    if (dispositivo.reached() && mensajesEntrantes && sincronizacionSegura)
        procesarMensajesDeRed();
    atenderBotonWifi(ms);
    if (!wifiConfigurando.load()) atenderCalibracionSerial(ms);
    else if (Serial.available()) { char input = Serial.read(); if (input == 'w') solicitarWifiLocal(true); }
    // Lectura: Entrega al modelo una instantánea de tiempo y sensores; el modelo decide la
    // siguiente transición.
    if (!wifiConfigurando.load()) atenderDispensacion(ms);
    actualizarIndicadores(ms);
    enviarTelemetria(ms);
}


