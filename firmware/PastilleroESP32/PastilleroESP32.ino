#ifndef PASTILLERO_STEPS_PER_TURN
#define PASTILLERO_STEPS_PER_TURN 3200
#endif
// Lectura: Una vuelta depende del microstepping del TB6600: 3200 pulsos por defecto, no 3200
// grados.
constexpr long STEPS_PER_TURN = PASTILLERO_STEPS_PER_TURN;
static_assert(STEPS_PER_TURN > 0 && STEPS_PER_TURN % 4 == 0,
              "Steps must divide into four compartments");
// Perfil histórico de cuatro posiciones: 800 pasos. V2 calcula con positions=5 (640 pasos).
// setup() aplica DEFAULT_POSITIONS=5; esta constante conserva compatibilidad con pruebas V1.
constexpr long STEPS_PER_SLOT = STEPS_PER_TURN / 4;
static_assert(STEPS_PER_TURN % 5 == 0, "Steps must also divide into five positions");
// Lectura: Duraciones relativas: 2 s para entregar y 15 s de pausa en la secuencia manual.
constexpr uint32_t DROP_MS = 2000, INTERVAL_MS = 15000;
// Lectura: Cinco minutos contados desde scheduledAt; no desde el regreso del motor.
constexpr int64_t OMIT_MS = 300000;

// ============================================================
// 6. VARIABLES Y MODELOS DE SENSORES Y ACTUADORES
// ============================================================
// Lectura: Estados 0 a 7 en este orden: Android interpreta los mismos números en la telemetría.
enum class State { Idle, Outward, Drop, Returning, Awaiting, Alert, ManualGap, Fault };
// Estas políticas puras también se ejecutan en PC, sin GPIO ni red.
bool wifiSetupAllowed(State state, bool stopped) { return state == State::Idle && stopped; }
bool wifiSetupExpired(uint32_t now, uint32_t start) { return uint32_t(now - start) >= 300000; }
bool wifiButtonRequest(bool idle, bool pressed, uint32_t now, bool& armed, bool& timing, uint32_t& since) {
    if (!idle) { armed = timing = false; return false; }
    if (!pressed) { armed = true; timing = false; return false; }
    if (!armed) return false;
    if (!timing) { timing = true; since = now; }
    if (uint32_t(now - since) < 8000) return false;
    armed = timing = false;
    return true;
}

// Lectura: Contrato de movimiento y persistencia: permite probar el controlador en PC sin GPIO.
// Modelo V2 de periféricos: se prueba en PC sin bibliotecas Arduino ni escrituras GPIO.
struct PeripheralSettings {
    bool ledEnabled = true, buzzerEnabled = true;
    bool lcdEnabled = false, exitSensorEnabled = false, servoEnabled = false, pumpEnabled = false;
    uint32_t pumpDurationMs = 2000;
};
class Feedback {
   public:
    bool ready = false, alert = false, buzzer = false, servoOpen = false, pump = false;
    uint32_t pumpSince = 0;
    bool previousConfirmation = false;
    bool confirmationVisible = false;
    uint32_t confirmationSince = 0;
    void tick(State state, uint32_t ms, bool confirmedNow, const PeripheralSettings& p) {
        if (confirmedNow && !previousConfirmation) { confirmationVisible = true; confirmationSince = ms; }
        if (state != State::Idle || (confirmationVisible && uint32_t(ms - confirmationSince) >= 5000)) confirmationVisible = false;
        bool warning = state == State::Alert || state == State::Fault;
        ready = p.ledEnabled && state == State::Awaiting;
        alert = p.ledEnabled && warning;
        buzzer = p.buzzerEnabled && (warning || state == State::Awaiting) && ms % 1000 < 100;
        servoOpen = p.servoEnabled && state == State::Drop;
        if (!p.pumpEnabled || warning || uint32_t(ms - pumpSince) >= p.pumpDurationMs)
            pump = false;
        // La bomba solo puede empezar después de una confirmación física recién registrada.
        if (confirmedNow && !previousConfirmation && p.pumpEnabled && !warning && !pump) {
            pump = true;
            pumpSince = ms;
        }
        previousConfirmation = confirmedNow;
    }
    static void lcd(State state, int compartment, bool simulation, char* first, char* second,
                    const char* cause = nullptr) {
        const char* names[] = {"En espera",        "Dispensando",        "Entregando",
                               "Volviendo a cero", "Toma tu pastilla", "ALERTA: revisar",
                               "Pausa secuencia",  "FALLO: revisar"};
        const char* title = names[int(state)];
        if (state == State::Alert && cause) {
            if (!strcmp(cause, "NO_EXIT"))
                title = "Sin salida";
            else if (!strcmp(cause, "MISSED"))
                title = "Dosis omitida";
            else if (!strcmp(cause, "BLOCKED"))
                title = "Revisar blister";
            else if (!strcmp(cause, "RECOVERY"))
                title = "Reinicio: revisar";
        }
        strncpy(first, title, 16);
        first[16] = 0;
        // snprintf escribe como máximo 16 caracteres más terminador, compatible con LCD 16x2.
        snprintf(second, 17, "%s C%d", simulation ? "SIMULACION" : "PASTILLERO", compartment);
    }
};
class ExitDetector {
    bool initialized = false, raw = false, stable = false;
    uint32_t changed = 0;

   public:
    bool sample(bool blocked, uint32_t ms) {
        if (!initialized) {
            initialized = true;
            raw = stable = blocked;
            changed = ms;
            return false;
        }
        if (blocked != raw) {
            raw = blocked;
            changed = ms;
        }
        if (raw != stable && uint32_t(ms - changed) >= 10) {
            stable = raw;
            return stable;
        }
        return false;
    }
};

// ============================================================
// 7. VARIABLES DE HORARIOS, MEDICAMENTOS Y RESERVAS
// ============================================================
struct Dose {
    // Lectura: Identidad estable: hasta 36 caracteres y el terminador cero; {} inicia el arreglo
    // vacío.
    char id[37]{};
    // Lectura: Fecha Unix UTC en milisegundos; 64 bits evita desbordar las fechas actuales.
    int64_t scheduledAt = 0;
    // Posición útil de la dosis: 1..4 con cinco espacios; cero queda reservado al retorno.
    int compartment = 1;
    char medicationId[37]{};
};
// Un evento debe conservar su texto aunque Controller reutilice active para otra dosis.
// En ArduinoJson 7.3.2 un const char[N] se trata como literal estático. Convertirlo a
// const char* selecciona la copia de la cadena con su longitud real, sin compartir el arreglo.
// La plantilla permite probar EXACTAMENTE esta escritura JSON en PC, sin incluir Arduino/GPIO.
template <typename JsonObjectType>
inline void writeDoseEvent(JsonObjectType event, const Dose& dose, const char* kind,
                           int64_t actual, bool simulation) {
    event["doseId"] = static_cast<const char*>(dose.id);
    event["medicationId"] = static_cast<const char*>(dose.medicationId);
    event["type"] = kind;
    event["scheduledAt"] = dose.scheduledAt;
    event["actualAt"] = actual;
    event["compartment"] = dose.compartment;
    event["simulation"] = simulation;
}
// La clave reservada también debe copiarse: active.id se reutilizará en otra entrega.
template <typename JsonRootType>
inline void reserveDoseId(JsonRootType& snapshot, const Dose& dose) {
    snapshot["done"][static_cast<const char*>(dose.id)] = true;
}
constexpr size_t SNAPSHOT_MAX_BYTES = 48000;
enum class SnapshotSource { Fresh, LegacyString, Blob, Invalid };
// El formato nuevo tiene prioridad. Si su marcador existe pero falta el bloque, no se
// retrocede a una copia antigua que podría olvidar reservas de dosis ya ejecutadas.
template <typename Store>
inline SnapshotSource snapshotSource(Store& store) {
    if (store.isKey("snapshot-v2")) return SnapshotSource::Blob;
    if (store.getUChar("snapshot-ver", 0) != 0) return SnapshotSource::Invalid;
    return store.isKey("snapshot") ? SnapshotSource::LegacyString : SnapshotSource::Fresh;
}
// NVS limita una cadena a 4000 bytes: el JSON completo se guarda como blob, no putString.
// Preferences confirma cada escritura. La reserva solo se acepta tras bloque y marcador.
template <typename Store>
inline bool saveSnapshotBlob(Store& store, const char* data, size_t length) {
    if (!data || length == 0 || length > SNAPSHOT_MAX_BYTES) return false;
    if (store.putBytes("snapshot-v2", data, length) != length) return false;
    return store.putUChar("snapshot-ver", 2) == 1;
}
template <typename Store>
inline size_t snapshotBlobSize(Store& store) {
    size_t length = store.getBytesLength("snapshot-v2");
    return length > 0 && length <= SNAPSHOT_MAX_BYTES ? length : 0;
}
template <typename Store>
inline bool readSnapshotBlob(Store& store, char* data, size_t capacity, size_t length) {
    if (!data || length == 0 || length > SNAPSHOT_MAX_BYTES || capacity <= length) return false;
    if (store.getBytes("snapshot-v2", data, length) != length || memchr(data, 0, length))
        return false;
    data[length] = '\0';
    return true;
}

// ============================================================
// 8. VARIABLES DE CONTROL Y ESTADOS
// ============================================================
struct Port {
    // Lectura: Destructor virtual: al liberar un adaptador a través de Port se respeta su tipo
    // concreto.
    virtual ~Port() = default;
    // Lectura: Ordena un destino absoluto en pasos; =0 exige que el adaptador implemente la
    // operación.
    virtual void move(long position) = 0;
    // Lectura: Consulta si el destino terminó; el controlador no espera dentro de esta llamada.
    virtual bool reached() = 0;
    // Lectura: Consulta la reserva durable del ID para impedir otra entrega de la misma dosis.
    virtual bool handled(const char* id) = 0;
    // Guardar en memoria persistente ANTES de devolver true. STARTED reserva el identificador.
    virtual bool record(const Dose& dose, const char* type, int64_t actual) = 0;
};
class Controller {
   public:
    explicit Controller(Port& port) : io(port) {
    }
    // Lectura: El controlador arranca en reposo; aún debe calibrarse antes de mover.
    State state = State::Idle;
    // Lectura: Cada arranque exige confirmar el cero; la memoria no conoce la posición mecánica
    // real.
    bool calibrated = false;
    // Capacidad V2: 96 dosis. count indica las ocupadas; nunca se recorta un plan silenciosamente.
    Dose doses[96]{};
    int positions = 4;
    bool requireExit = false, exitDetected = false;
    const char* lastEvent = nullptr;
    int currentCompartment() const {
        return slot;
    }
    bool geometry(int value) {
        if ((value != 4 && value != 5) ||
            (busy() && state != State::Alert && state != State::Fault))
            return false;
        if (positions != value) {
            positions = value;
            calibrated = false;
        }
        return true;
    }
    int count = 0;
    // Lectura: Consulta de solo lectura: cualquier estado distinto de Idle impide iniciar otra
    // secuencia.
    bool busy() const {
        return state != State::Idle;
    }
    // Lectura: Inicia s únicamente en reposo y calibrado; ms es millis(), no una fecha UTC.
    bool manualStart(uint32_t ms) {
        if (busy() || !calibrated)
            return false;
        manual = true;
        slot = 1;
        beginMove(ms);
        return true;
    }
    // Lectura: Avanza una transición sin esperar: recibe tiempo relativo, fecha, presencia y botón
    // ya filtrado.
    void tick(uint32_t ms, int64_t epoch, bool blister, bool pressed, bool exitPulse = false) {
        if ((state == State::Outward || state == State::Drop || state == State::Returning) &&
            exitPulse)
            exitDetected = true;
        // Lectura: Fallo seguro: no se intenta dispensar mientras la persistencia o la
        // inicialización estén dañadas.
        if (state == State::Fault)
            return;
        if (state == State::Idle) {
            if (!io.reached())
                return;
            // Lectura: No evalúa horarios con un reloj aún no sincronizado; LL conserva el literal
            // en 64 bits.
            if (epoch < 1700000000000LL)
                return;
            // Lectura: Todavía no hay candidata; -1 evita confundir ausencia con el índice cero del
            // arreglo.
            int next = -1;
            for (int i = 0; i < count; ++i)
                // Lectura: Solo considera dosis vencidas cuyo ID no esté reservado; la línea
                // siguiente elige la más Lectura: antigua.
                if (!io.handled(doses[i].id) && doses[i].scheduledAt <= epoch &&
                    (next < 0 || doses[i].scheduledAt < doses[next].scheduledAt))
                    next = i;
            if (next < 0)
                return;
            // Lectura: Copia la candidata: la entrega en curso mantiene su identidad aunque luego
            // llegue otro plan.
            active = doses[next];
            // Lectura: Si ya venció el margen de cinco minutos, registra omisión en lugar de
            // iniciar una entrega Lectura: tardía.
            if (epoch - active.scheduledAt >= OMIT_MS) {
                log("MISSED", epoch);
                state = state == State::Fault ? state : State::Alert;
                return;
            }
            if (!calibrated || !io.reached())
                return;
            // Lectura: Sin presencia de blíster se registra BLOCKED y se pide revisión; no comienza
            // el giro.
            if (!blister) {
                log("BLOCKED", epoch);
                if (state != State::Fault)
                    state = State::Alert;
                return;
            }
            // Lectura: Reserva y persiste el ID antes de mover. Si falla, log deja el controlador
            // en Fault.
            if (!log("STARTED", epoch))
                return;
            manual = false;
            // Lectura: Un horario selecciona una sola posición; s ejecuta la secuencia manual
            // completa.
            slot = active.compartment;
            beginMove(ms);
            return;
        }
        // Lectura: Al llegar al compartimento cambia a entrega y empieza a medir su espera de dos
        // segundos.
        if (state == State::Outward && io.reached()) {
            state = State::Drop;
            since = ms;
            // Lectura: La resta unsigned tolera la vuelta de millis(); se comprueba el tiempo sin
            // detener loop().
        } else if (state == State::Drop && uint32_t(ms - since) >= DROP_MS) {
            // Lectura: Después de entregar solicita volver al cero previamente calibrado.
            io.move(0);
            state = State::Returning;
        } else if (state == State::Returning && io.reached()) {
            if (manual) {
                state = State::ManualGap;
                since = ms;
            } else if (requireExit && !exitDetected) {
                if (log("NO_EXIT", epoch)) {
                    state = State::Alert;
                    released = false;
                }
            } else {
                state = State::Awaiting;
                // Lectura: Exige soltar y volver a pulsar: un botón mantenido durante el giro no
                // confirma una toma.
                released = !pressed;
            }
        } else if (state == State::Awaiting) {
            if (!pressed)
                released = true;
            // Lectura: Si ya venció el margen de cinco minutos, registra omisión en lugar de
            // iniciar una entrega Lectura: tardía.
            if (epoch - active.scheduledAt >= OMIT_MS) {
                if (log("MISSED", epoch)) {
                    state = State::Alert;
                    released = false;
                }
                // Lectura: Solo una pulsación posterior a la liberación puede registrar CONFIRMED.
            } else if (pressed && released) {
                if (log("CONFIRMED", epoch))
                    state = State::Idle;
            }
            // Lectura: Reconocer una alerta vuelve al reposo; no transforma una omisión en una toma
            // confirmada.
        } else if (state == State::Alert) {
            if (!pressed)
                released = true;
            if (pressed && released) {
                state = State::Idle;
                released = false;
            }
        } else if (state == State::ManualGap && uint32_t(ms - since) >= INTERVAL_MS) {
            // Tras la pausa termina s o avanza al siguiente compartimento útil: con cinco
            // espacios recorre 1→0, 2→0, 3→0, 4→0; el espacio cero siempre queda vacío.
            if (++slot >= positions) {
                manual = false;
                state = State::Idle;
            } else
                beginMove(ms);
        }
    }

   private:
    Port& io;
    Dose active{};
    int slot = 1;
    bool manual = false, released = false;
    uint32_t since = 0;
    // Lectura: Anota el inicio y calcula el destino absoluto; el adaptador hará el movimiento
    // progresivo.
    void beginMove(uint32_t ms) {
        since = ms;
        // NEMA 17/TB6600: destino absoluto = compartimento × pasos/vuelta ÷ espacios.
        // Con cinco espacios y 3200 pasos: 640, 1280, 1920 y 2560; después retorna a cero.
        exitDetected = false;
        io.move(slot * STEPS_PER_TURN / positions);
        state = State::Outward;
    }
    // Lectura: Centraliza el registro durable: una escritura fallida bloquea las entregas
    // posteriores.
    bool log(const char* kind, int64_t epoch) {
        if (io.record(active, kind, epoch)) {
            lastEvent = kind;
            return true;
        }
        state = State::Fault;
        return false;
    }
};
inline bool validDose(const Dose& d, int positions = 4);
// Lectura: Valida ID, compartimento y rango de fecha antes de aceptar un horario desde JSON.
inline bool validDose(const Dose& d, int positions) {
    size_t n = strlen(d.id);
    if (n < 1 || n > 36 || d.compartment < 1 || d.compartment >= positions ||
        (positions != 4 && positions != 5) || d.scheduledAt < 1700000000000LL ||
        d.scheduledAt > 4102444800000LL)
        return false;
    for (size_t i = 0; i < n; i++)
        if (!((d.id[i] >= 'a' && d.id[i] <= 'z') || (d.id[i] >= 'A' && d.id[i] <= 'Z') ||
              (d.id[i] >= '0' && d.id[i] <= '9') || d.id[i] == '-'))
            return false;
    return true;
}
}  // namespace pill

namespace pill {
inline bool planModeMatches(const char* mode, bool simulation);
// Lectura: Un plan simulation solo sirve en simulación; un plan hardware solo en la variante
// física.
inline bool planModeMatches(const char* mode, bool simulation) {
    return mode && !strcmp(mode, simulation ? "simulation" : "hardware");
}
// PING observa la conexión y APPLY_PLAN comprueba una revisión: ninguno mueve el motor ni confirma
// tomas.
inline const char* commandDecision(const char* type, const char* mode, bool simulation,
                                   int64_t requested, int64_t expires, int64_t now, int revision,
                                   int applied);
inline const char* commandDecision(const char* type, const char* mode, bool simulation,
                                   int64_t requested, int64_t expires, int64_t now, int revision,
                                   int applied) {
    // Lectura: strcmp devuelve cero si ambos textos coinciden; otro modo se rechaza sin ejecutar el
    // comando.
    if (strcmp(mode, simulation ? "simulation" : "hardware"))
        return "WRONG_MODE";
    if (now < 1700000000000LL || requested > now + 60000 || expires <= requested ||
        // Lectura: El comando dura como máximo diez minutos y debe seguir vigente al procesarse.
        expires - requested > 600000 || expires <= now)
        return "EXPIRED_OR_INVALID_TIME";
    if (!strcmp(type, "PING"))
        return revision == 0 ? "OK" : "INVALID_REVISION";
    if (!strcmp(type, "APPLY_PLAN")) {
        if (revision < 1)
            return "INVALID_REVISION";
        // Lectura: APPLY_PLAN espera hasta que el firmware haya aplicado esa revisión o una
        // posterior.
        return applied >= revision ? "OK" : "WAIT";
    }
    // Lectura: Solo se admiten PING y APPLY_PLAN; no existe una orden remota de movimiento ni de
    // confirmación.
    return "UNKNOWN_COMMAND";
}
