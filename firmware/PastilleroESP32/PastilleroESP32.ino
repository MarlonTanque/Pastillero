// 11. FUNCIONES WIFI Y FIREBASE
// ============================================================
class RespuestaLimitada : public Stream {
   public:
    String value;
    int available() override {
        return 0;
    }
    int read() override {
        return -1;
    }
    int peek() override {
        return -1;
    }
    void flush() override {
    }
    size_t write(uint8_t c) override {
        return write(&c, 1);
    }
    size_t write(const uint8_t* data, size_t n) override {
        // Lectura: El límite también se comprueba al recibir por fragmentos, aunque el servidor no
        // indique tamaño Lectura: total.
        if (value.length() + n > 48000)
            return 0;
        return value.concat(reinterpret_cast<const char*>(data), n) ? n : 0;
    }
};
// Envía una solicitud HTTPS con raíces verificadas, tiempos máximos y respuesta de tamaño limitado.
String solicitudHttps(const String& url, const String& method, const String& body, int& code,
                      const String& contentType) {
    WiFiClientSecure tls;
    // Lectura: Verifica la cadena TLS del servidor mediante raíces públicas; no se usa
    // setInsecure().
    tls.setCACert(GOOGLE_ROOTS);
    // Lectura: Limita a ocho segundos la negociación TLS en la tarea de red separada.
    tls.setHandshakeTimeout(8);
    HTTPClient http;
    http.setConnectTimeout(5000);
    http.setTimeout(5000);
    if (!http.begin(tls, url)) {
        code = -1;
        return "";
    }
    http.addHeader("Content-Type", contentType);
    // Lectura: GET consulta, POST autentica y PUT publica; code recibe el estado HTTP, no el cuerpo
    // JSON.
    code = http.sendRequest(method.c_str(), body);
    RespuestaLimitada result;
    if (code > 0 && http.getSize() <= 48000) {
        // Lectura: Un fallo o exceso de tamaño invalida la respuesta; no se interpreta un JSON
        // truncado como éxito.
        if (http.writeToStream(&result) < 0) {
            code = -2;
            result.value = "";
        }
    } else {
        code = -2;
    }
    // Lectura: Libera la conexión HTTPS antes de devolver el cuerpo recibido.
    http.end();
    return result.value;
}

// Inicia sesión o renueva el token de la cuenta ordinaria; no almacena credenciales administrativas.
void mantenerSesionFirebase(String& token, String& refresh, uint32_t& refreshed, uint32_t ms) {
    int code;
    // Lectura: Autentica si falta token o han pasado unos cincuenta minutos; el token no se guarda
    // en el APK.
    if (token.isEmpty() || uint32_t(ms - refreshed) > 3000000) {
        String result;
        if (refresh.isEmpty()) {
            JsonDocument login;
            login["email"] = DEVICE_EMAIL;
            login["password"] = DEVICE_PASSWORD;
            // Lectura: Solicita un ID token y un refresh token de Firebase Authentication, con
            // privilegios del Lectura: dispositivo.
            login["returnSecureToken"] = true;
            String body;
            serializeJson(login, body);
            result = solicitudHttps(
                String(
                    "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=") +
                    FIREBASE_API_KEY,
                "POST", body, code);
        } else {
            result = solicitudHttps(
                String("https://securetoken.googleapis.com/v1/token?key=") + FIREBASE_API_KEY,
                "POST", String("grant_type=refresh_token&refresh_token=") + refresh, code,
                "application/x-www-form-urlencoded");
        }
        JsonDocument auth;
        if (code == 200 && !deserializeJson(auth, result)) {
            token = auth["idToken"].isNull() ? (auth["id_token"] | "") : (auth["idToken"] | "");
            refresh = auth["refreshToken"].isNull() ? (auth["refresh_token"] | "")
                                                    : (auth["refreshToken"] | "");
            refreshed = ms;
        } else {
            token = "";
            refresh = "";
        }
    }
}

// Consulta el programa y solicitudes; publica eventos y resultados con claves estables y acuses.
void sincronizarConFirebase(String& token, JsonDocument& latest) {
    int code;
    if (!token.isEmpty()) {
        String base = String(FIREBASE_DATABASE_URL) + "/devices/" + DEVICE_ID + "/v2";
        String auth = String(".json?auth=") + token;
        String plan = solicitudHttps(base + "/program" + auth, "GET", "", code);
        if (code == 200 && plan != "null")
            encolarMensaje(mensajesEntrantes, String("{\"plan\":") + plan + "}");
        // Lectura: Una sesión inválida vacía el token para volver a autenticar; no se recurre a
        // acceso público.
        if (code == 401)
            token = "";
        // Leer solo solicitudes y resultados recientes limita memoria y tráfico.
        String commands = solicitudHttps(
            base + "/commandRequests" + auth + "&orderBy=%22requestedAt%22&limitToLast=32", "GET",
            "", code);
        JsonDocument requests;
        if (code == 200)
            deserializeJson(requests, commands);
        String mode = PASTILLERO_DRY_RUN ? "simulation" : "hardware";
        String results = solicitudHttps(
            base + "/commandResults/" + mode + auth + "&orderBy=%22executedAt%22&limitToLast=64",
            "GET", "", code);
        JsonDocument completed;
        if (code == 200)
            deserializeJson(completed, results);
        if (code == 200)
            for (JsonPair entry : requests.as<JsonObject>()) {
                if (!completed[entry.key()].isNull() ||
                    !latest["commandResults"][entry.key()].isNull())
                    continue;
                JsonDocument message;
                message["commandId"] = entry.key().c_str();
                message["command"].set(entry.value());
                String text;
                serializeJson(message, text);
                encolarMensaje(mensajesEntrantes, text);
            }
        // Lectura: Reintenta cada resultado con su misma clave; solo retira el pendiente después de
        // HTTP 200.
        for (JsonPair entry : latest["commandResults"].as<JsonObject>()) {
            String body;
            serializeJson(entry.value(), body);
            solicitudHttps(base + "/commandResults/" + mode + "/" + entry.key().c_str() + auth,
                           "PUT", body, code);
            if (code == 200)
                encolarMensaje(mensajesEntrantes,
                               String("{\"commandAck\":\"") + entry.key().c_str() + "\"}");
            else
                break;
        }
        // Lectura: Reenvía eventos durables conservando ID y contenido; las reglas permiten
        // únicamente la repetición Lectura: idéntica.
        for (JsonPair e : latest["events"].as<JsonObject>()) {
            String body;
            serializeJson(e.value(), body);
            solicitudHttps(base + "/events/" + e.key().c_str() + auth, "PUT", body, code);
            if (code == 200)
                encolarMensaje(mensajesEntrantes, String("{\"ack\":\"") + e.key().c_str() + "\"}");
            else
                break;
        }
        if (!latest["state"].isNull()) {
            String body;
            serializeJson(latest["state"], body);
            solicitudHttps(base + "/state" + auth, "PUT", body, code);
        }
    }
}

// Aísla Wi-Fi, autenticación y red en otra tarea; recibe instantáneas mediante colas.
void tareaFirebase(void*) {
    String token, refresh;
    uint32_t refreshed = 0, attempt = 0, wifiAttempt = 0, backoff = 5000;
    JsonDocument latest;
    for (;;) {
        // Lectura: Captura tiempo desde el arranque para intervalos; nunca se compara directamente
        // con una fecha Unix.
        uint32_t ms = millis();
        atenderWifiDinamico(ms);
        if (wifiConfigurando.load()) { vTaskDelay(pdMS_TO_TICKS(20)); continue; }
        if (WiFi.status() != WL_CONNECTED && uint32_t(ms - wifiAttempt) >= backoff) {
            wifiAttempt = ms;
            // Sin literales SSID/password: el driver usa la última red aceptada en NVS.
            WiFi.begin();
            // Lectura: Espacia los reintentos Wi-Fi hasta un máximo de sesenta segundos para no
            // saturar la red.
            backoff = min(backoff * 2, uint32_t(60000));
        }
        MensajeRed m;
        while (xQueueReceive(mensajesSalientes, &m, 0) == pdTRUE) {
            deserializeJson(latest, m.text);
            free(m.text);
        }
        if (WiFi.status() == WL_CONNECTED && obtenerHoraUtcMs() > 1700000000000LL &&
            strlen(FIREBASE_API_KEY) && strlen(FIREBASE_DATABASE_URL) && uint32_t(ms - attempt) >= 5000) {
            attempt = ms;
            backoff = 5000;
            mantenerSesionFirebase(token, refresh, refreshed, ms);
            sincronizarConFirebase(token, latest);
        }
        // Lectura: Cede CPU veinte milisegundos solo en la tarea de red; loop sigue atendiendo el
        // motor.
        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// Crea colas y tareas, activa estación Wi-Fi y solicita sincronización UTC mediante NTP.
void prepararColasYRed() {
    mensajesEntrantes = xQueueCreate(8, sizeof(MensajeRed));
    mensajesSalientes = xQueueCreate(2, sizeof(MensajeRed));
    if (!mensajesEntrantes || !mensajesSalientes) {
        controlador.state = pill::State::Fault;
        return;
    }
#if !PASTILLERO_DRY_RUN
    if (PASTILLERO_LCD_AVAILABLE) {
        mensajesPantalla = xQueueCreate(1, sizeof(TextoPantalla));
        if (!mensajesPantalla ||
            xTaskCreatePinnedToCore(tareaPantalla, "lcd", 4096, nullptr, 1, nullptr, 0) != pdPASS)
            controlador.state = pill::State::Fault;
    }
#endif
    WiFi.persistent(true);
    WiFi.mode(WIFI_STA);
    WiFi.setAutoReconnect(true);
    inicializarWifiDinamico();
    // Lectura: Configura NTP en UTC, sin desplazamiento horario; Android convierte su selección
    // local a época Unix.
    configTime(0, 0, "time.google.com", "pool.ntp.org");
    if (xTaskCreatePinnedToCore(tareaFirebase, "firebase", 16384, nullptr, 1, nullptr, 0) != pdPASS)
        controlador.state = pill::State::Fault;
}


// Inicializa sin borrar historial ni configuración de dosis. Un cambio interrumpido vuelve a la red anterior.
void inicializarWifiDinamico() {
    wifiPersistencia = memoriaWifi.begin("wifi-setup", false);
    if (!wifiPersistencia) { Serial.println("No se pudo abrir la memoria Wi-Fi"); return; }
    if (memoriaWifi.getBytesLength("rollback") == sizeof(wifi_config_t)) {
        wifi_config_t anterior{};
        if (memoriaWifi.getBytes("rollback", &anterior, sizeof(anterior)) != sizeof(anterior) ||
            esp_wifi_set_config(WIFI_IF_STA, &anterior) != ESP_OK) {
            wifiPersistencia = false; return;
        }
        memoriaWifi.remove("rollback");
    }
    if (memoriaWifi.getString("code", "").length() != 24) {
        uint8_t random[12]; esp_fill_random(random, sizeof(random));
        for (size_t i = 0; i < sizeof(random); i++) snprintf(codigoWifi + i*2, 3, "%02x", random[i]);
        if (memoriaWifi.putString("code", codigoWifi) != 24) { wifiPersistencia = false; return; }
    } else memoriaWifi.getString("code", codigoWifi, sizeof(codigoWifi));
    uint8_t mac[6]{}; esp_wifi_get_mac(WIFI_IF_STA, mac);
    snprintf(nombreWifi, sizeof(nombreWifi), "BADI_SETUP_%02X%02X%02X", mac[3], mac[4], mac[5]);
    wifi_config_t actual{};
    if (esp_wifi_get_config(WIFI_IF_STA, &actual) == ESP_OK && actual.sta.ssid[0]) WiFi.begin();
    else if (pill::wifiSetupAllowed(controlador.state, dispositivo.reached())) {
        wifiConfigurando = true; wifiSolicitada = true;
    }
}
// El código se obtiene una vez por USB para la etiqueta; no es la contraseña del router.
// Nunca se imprime durante el arranque ni se envía a Firebase. No ejecutar w automáticamente en QA.
void solicitarWifiLocal(bool mostrarCodigo) {
    if (!wifiPersistencia || (!wifiConfigurando && !pill::wifiSetupAllowed(controlador.state, dispositivo.reached()))) {
        Serial.println("Wi-Fi: espere a reposo y revise memoria"); return;
    }
    if (mostrarCodigo) Serial.printf("ETIQUETA LOCAL: %s / %s\n", nombreWifi, codigoWifi);
    if (!wifiConfigurando) { wifiConfigurando = true; wifiSolicitada = true; }
}
void atenderBotonWifi(uint32_t ms) {
    static bool armed = false, timing = false;
    static uint32_t since = 0;
    bool pressed = false;
#if !PASTILLERO_DRY_RUN
    pressed = digitalRead(PIN_BUTTON) == LOW;
#endif
    bool idle = !wifiConfigurando && pill::wifiSetupAllowed(controlador.state, dispositivo.reached());
    if (pill::wifiButtonRequest(idle, pressed, ms, armed, timing, since)) solicitarWifiLocal(false);
}
// Solo la tarea de red toca el gestor/NVS Wi-Fi; loop no espera conexiones ni escribe esas contraseñas.
void atenderWifiDinamico(uint32_t ms) {
    if (wifiSolicitada.exchange(false)) {
        wifi_config_t anterior{};
        if (!wifiPersistencia || esp_wifi_get_config(WIFI_IF_STA, &anterior) != ESP_OK ||
            memoriaWifi.putBytes("rollback", &anterior, sizeof(anterior)) != sizeof(anterior)) {
            wifiConfigurando = false; Serial.println("Wi-Fi: no se pudo proteger la red anterior"); return;
        }
        WiFi.setAutoReconnect(false);
        WiFi.disconnect(false, false);
        network_prov_mgr_config_t config{};
        config.scheme = network_prov_scheme_softap;
        config.app_event_handler.event_cb = [](void*, network_prov_cb_event_t event, void*) {
            if (event == NETWORK_PROV_WIFI_CRED_SUCCESS) wifiRecibida = true;
            if (event == NETWORK_PROV_WIFI_CRED_FAIL) wifiFallo = true;
        };
        inicioWifi = ms; exitoWifi = 0; wifiRecibida = false; wifiFallo = false;
        gestorWifi = network_prov_mgr_init(config) == ESP_OK;
        if (gestorWifi) {
            network_prov_mgr_disable_auto_stop(1000);
            if (network_prov_mgr_start_provisioning(NETWORK_PROV_SECURITY_1, codigoWifi, nombreWifi, codigoWifi) != ESP_OK)
                inicioWifi = ms - 300000;
        } else inicioWifi = ms - 300000;
    }
    if (!wifiConfigurando) return;
    if (gestorWifi && wifiFallo.exchange(false)) network_prov_mgr_reset_wifi_sm_state_on_failure();
    if (wifiRecibida.load() && WiFi.status() == WL_CONNECTED && !exitoWifi) exitoWifi = ms ? ms : 1;
    bool success = exitoWifi && uint32_t(ms - exitoWifi) >= 10000;
    if (!success && !pill::wifiSetupExpired(ms, inicioWifi)) return;
    if (gestorWifi) { network_prov_mgr_stop_provisioning(); network_prov_mgr_deinit(); gestorWifi = false; }
    if (!success && memoriaWifi.getBytesLength("rollback") == sizeof(wifi_config_t)) {
        wifi_config_t anterior{};
        if (memoriaWifi.getBytes("rollback", &anterior, sizeof(anterior)) != sizeof(anterior) ||
            esp_wifi_set_config(WIFI_IF_STA, &anterior) != ESP_OK) {
            Serial.println("Wi-Fi: recuperación pendiente; configuración retenida"); return;
        }
    }
    if (!memoriaWifi.remove("rollback")) { Serial.println("Wi-Fi: no se confirmó persistencia"); return; }
    WiFi.mode(WIFI_STA); WiFi.setAutoReconnect(true);
    if (!success) WiFi.begin();
    wifiConfigurando = false;
    Serial.println(success ? "Wi-Fi: nueva red aceptada" : "Wi-Fi: cambio cancelado, red anterior recuperada");
}

// ============================================================
// 12. FUNCIONES DEL MOTOR Y CALIBRACION
// ============================================================
// Configura GPIO y AccelStepper únicamente en la variante física; respeta bloqueos de periféricos.
void configurarMotorYSensores() {
#if !PASTILLERO_DRY_RUN
    motor.enableOutputs();
    pinMode(PIN_BUTTON, INPUT_PULLUP);
    pinMode(PIN_BUZZER, OUTPUT);
    pinMode(PIN_READY, OUTPUT);
    pinMode(PIN_ALERT, OUTPUT);
    // Lectura: Conserva inversión de DIR y STEP del montaje original; no altera la secuencia de
    // compartimentos.
    motor.setPinsInverted(true, true);
    // Lectura: Fija un pulso mínimo de diez microsegundos; verificar compatibilidad del módulo
    // TB6600 real.
    motor.setMinPulseWidth(10);
    // Lectura: Límite de velocidad: mil pasos por segundo, no revoluciones por minuto.
    motor.setMaxSpeed(1000);
    // Lectura: Aceleración de quinientos pasos por segundo al cuadrado para los movimientos
    // progresivos.
    motor.setAcceleration(500);
    if (PASTILLERO_EXIT_AVAILABLE)
        pinMode(PIN_EXIT, INPUT);
    if (PASTILLERO_PUMP_AVAILABLE) {
        pinMode(PIN_PUMP, OUTPUT);
        digitalWrite(PIN_PUMP, LOW);
    }
    if (PASTILLERO_SERVO_AVAILABLE && !ledcAttach(PIN_SERVO, 50, 16)) {
        falloPerifericos = true;
        controlador.state = pill::State::Fault;
    }
#endif
}

// Interpreta a/r/c/s solo con el motor detenido; fija cero y conserva el recorrido por compartimentos.
void atenderCalibracionSerial(uint32_t ms) {
    if (Serial.available()) {
        char c = Serial.read();
        if (c == 'w') { solicitarWifiLocal(true); return; }
        if (!controlador.busy() && dispositivo.reached()) {
            // Lectura: Antes de c, a suma diez pasos y r resta diez; no gira una vuelta completa.
            if (!controlador.calibrated && (c == 'a' || c == 'r')) {
#if PASTILLERO_DRY_RUN
                dispositivo.move(posicionSimulada + (c == 'a' ? 10 : -10));
#else
                dispositivo.move(motor.currentPosition() + (c == 'a' ? 10 : -10));
#endif
                // Lectura: c fija como cero la posición actual una sola vez por arranque; no busca
                // un final de carrera.
            } else if (c == 'c' && !controlador.calibrated) {
#if !PASTILLERO_DRY_RUN
                // Lectura: Renombra la posición actual como cero sin movimiento físico.
                motor.setCurrentPosition(0);
#endif
                posicionSimulada = 0;
                controlador.calibrated = true;
                Serial.println("Punto 0 confirmado");
                // Lectura: s inicia la secuencia manual calibrada; no es un comando recibido desde
                // Android.
            } else if (c == 's')
                controlador.manualStart(ms);
        }
    }
}


// ============================================================
// 13. FUNCIONES DE DISPENSACION
// ============================================================
// Controller.tick, definido en la sección 8, es la misma máquina de estados probada en PC.
void atenderDispensacion(uint32_t ms) {
    auto previous = controlador.state;
    if (!indicadores.pump)
        controlador.tick(ms, obtenerHoraUtcMs(), hayBlister(), leerBotonConfirmacion(),
                         leerSalidaPastilla(ms));
    confirmacionReciente =
        previous == pill::State::Awaiting && controlador.state == pill::State::Idle;
}

// ============================================================
// 14. FUNCIONES DE SENSORES
// ============================================================
// Devuelve una pulsación filtrada por estabilidad; en simulación no consulta GPIO.
bool leerBotonConfirmacion() {
#if PASTILLERO_DRY_RUN
    return false;
#else
    static bool raw = false, stable = false;
    static uint32_t changed = 0;
    // Lectura: INPUT_PULLUP hace que pulsar contra GND sea LOW; now=true significa botón
    // presionado.
    bool now = digitalRead(PIN_BUTTON) == LOW;
    if (now != raw) {
        raw = now;
        changed = millis();
    }
    if (uint32_t(millis() - changed) >= 40)
        stable = raw;
    return stable;
#endif
}

// Comprueba presencia mediante el umbral óptico; no equivale al sensor de salida ni a ingestión.
bool hayBlister() {
#if PASTILLERO_DRY_RUN
    return true;
#else
    return analogRead(PIN_OPTICAL) >= OPTICAL_THRESHOLD;
#endif
}

// Filtra el sensor de salida independiente; en simulación aporta una entrada ficticia controlada.
bool leerSalidaPastilla(uint32_t ms) {
#if PASTILLERO_DRY_RUN
    return false;
#else
    return PASTILLERO_EXIT_AVAILABLE && preferencias.exitSensorEnabled &&
           detectorSalida.sample(digitalRead(PIN_EXIT) == LOW, ms);
#endif
}


// ============================================================
// 15. FUNCIONES DE ALERTAS, LCD Y PERIFERICOS
// ============================================================
class Pantalla16x2 {
    void expander(uint8_t value) {
        Wire.beginTransmission(LCD_ADDRESS);
        Wire.write(value | 0x08);
        Wire.endTransmission();
    }
    void nibble(uint8_t value) {
        expander(value | 0x04);
        delayMicroseconds(1);
        expander(value & ~0x04);
        delayMicroseconds(50);
    }
    void send(uint8_t value, bool data) {
        uint8_t rs = data ? 1 : 0;
        nibble((value & 0xf0) | rs);
        nibble((value << 4) | rs);
    }

   public:
    void begin() {
        Wire.begin(PIN_SDA, PIN_SCL);
        Wire.setTimeOut(20);
        vTaskDelay(pdMS_TO_TICKS(50));
        nibble(0x30);
        vTaskDelay(pdMS_TO_TICKS(5));
        nibble(0x30);
        nibble(0x30);
        nibble(0x20);
        send(0x28, false);
        send(0x0c, false);
        send(0x06, false);
    }
    void line(int row, const char* text) {
        send(row ? 0xc0 : 0x80, false);
        for (int i = 0; i < 16; i++)
            send(i < int(strlen(text)) ? text[i] : ' ', true);
    }
};
// Actualiza el LCD por I2C desde una cola separada para no detener los pulsos del motor.
void tareaPantalla(void*) {
#if !PASTILLERO_DRY_RUN
    Pantalla16x2 lcd;
    bool initialized = false;
    TextoPantalla text;
    for (;;) {
        if (xQueueReceive(mensajesPantalla, &text, pdMS_TO_TICKS(500)) == pdTRUE) {
            if (!initialized) {
                lcd.begin();
                initialized = true;
            }
            lcd.line(0, text.first);
            lcd.line(1, text.second);
        }
    }
#else
    vTaskDelete(nullptr);
#endif
}

// Calcula avisos, servo y bomba; aplica preferencias sin saltar las disponibilidades locales.
void actualizarIndicadores(uint32_t ms) {
    indicadores.tick(controlador.state, ms, confirmacionReciente, preferencias);
#if !PASTILLERO_DRY_RUN
    digitalWrite(PIN_ALERT, indicadores.alert);
    digitalWrite(PIN_READY, indicadores.ready);
    digitalWrite(PIN_BUZZER, indicadores.buzzer);
    if (PASTILLERO_PUMP_AVAILABLE)
        digitalWrite(PIN_PUMP, indicadores.pump ? HIGH : LOW);
    if (PASTILLERO_SERVO_AVAILABLE)
        ledcWrite(PIN_SERVO, preferencias.servoEnabled
                                 ? (indicadores.servoOpen ? SERVO_OPEN_US : SERVO_CLOSED_US) *
                                       65535UL / 20000UL
                                 : 0);
#endif
    static int last = -1;
    static uint32_t printed = 0;
    if (preferencias.lcdEnabled &&
        (last != int(controlador.state) || uint32_t(ms - printed) >= 2000)) {
        last = int(controlador.state);
        printed = ms;
        TextoPantalla text;
        pill::Feedback::lcd(controlador.state, controlador.currentCompartment(), PASTILLERO_DRY_RUN,
                            text.first, text.second, controlador.lastEvent);
        if (indicadores.confirmationVisible) {
            snprintf(text.first, sizeof(text.first), "Toma confirmada");
            snprintf(text.second, sizeof(text.second), "Aviso apagado");
        }
#if PASTILLERO_DRY_RUN
        Serial.printf("LCD SIM: [%s] [%s]\n", text.first, text.second);
#else
        if (PASTILLERO_LCD_AVAILABLE && mensajesPantalla)
            xQueueOverwrite(mensajesPantalla, &text);
#endif
    }
}


// ============================================================
// 16. FUNCIONES DE CALENDARIO Y VALIDACION DE HORARIOS
// ============================================================
// Android expande semana/intervalos a UTC; el ESP32 compara estas fechas sin esperar ni reconstruir pautas.
// Convierte segundos UTC a milisegundos para comparar horarios; millis se reserva a intervalos.
int64_t obtenerHoraUtcMs() {
    return int64_t(time(nullptr)) * 1000;
}

// Valida modo, geometría, campos, límites e identidades de todas las dosis antes de aceptar un plan.
bool validarPlanRecibido(JsonVariantConst plan, pill::Dose* list, int& count) {
    count = 0;
    if (!plan["version"].is<int>() || plan["version"].as<int>() != 2 ||
        !pill::planModeMatches(plan["targetMode"].as<const char*>(), PASTILLERO_DRY_RUN))
        return false;
    int positions = plan["positions"] | 0;
    if ((positions != 4 && positions != 5) || !plan["revision"].is<int>() ||
        plan["revision"].as<int>() < 1 ||
        (!plan["doses"].isNull() && !plan["doses"].is<JsonObjectConst>()) ||
        plan["doses"].size() > 96)
        return false;
    auto settings = plan["settings"];
    const char* flags[] = {"ledEnabled",        "buzzerEnabled", "lcdEnabled",
                           "exitSensorEnabled", "servoEnabled",  "pumpEnabled"};
    for (const char* flag : flags)
        if (!settings[flag].is<bool>())
            return false;
    if (!settings["positions"].is<int>() || settings["positions"].as<int>() != positions ||
        !settings["pumpDurationMs"].is<int>() || settings["pumpDurationMs"].as<int>() < 500 ||
        settings["pumpDurationMs"].as<int>() > 5000)
        return false;
#if !PASTILLERO_DRY_RUN
    if ((settings["lcdEnabled"].as<bool>() && !PASTILLERO_LCD_AVAILABLE) ||
        (settings["exitSensorEnabled"].as<bool>() && !PASTILLERO_EXIT_AVAILABLE) ||
        (settings["servoEnabled"].as<bool>() && !PASTILLERO_SERVO_AVAILABLE) ||
        (settings["pumpEnabled"].as<bool>() && !PASTILLERO_PUMP_AVAILABLE))
        return false;
#endif
    for (JsonPairConst pair : plan["doses"].as<JsonObjectConst>()) {
        auto value = pair.value();
        pill::Dose d;
        if (strlen(pair.key().c_str()) > 36 || !value["scheduledAt"].is<int64_t>() ||
            !value["compartment"].is<int>() || !value["medicationId"].is<const char*>())
            return false;
        const char* medication = value["medicationId"];
        if (strlen(medication) < 1 || strlen(medication) > 36)
            return false;
        strlcpy(d.id, pair.key().c_str(), sizeof(d.id));
        strlcpy(d.medicationId, value["medicationId"], sizeof(d.medicationId));
        d.scheduledAt = value["scheduledAt"];
        d.compartment = value["compartment"];
        if (!pill::validDose(d, positions))
            return false;
        pill::Dose check = d;
        strlcpy(check.id, medication, sizeof(check.id));
        if (!pill::validDose(check, positions))
            return false;
        auto old = registroLocal["plan"]["doses"][d.id];
        if (!old.isNull() && (old["scheduledAt"].as<int64_t>() != d.scheduledAt ||
                              old["compartment"].as<int>() != d.compartment))
            return false;
        list[count++] = d;
    }
    return true;
}


// ============================================================
// 17. FUNCIONES DE SINCRONIZACION Y PERSISTENCIA
// ============================================================
// Serializa y persiste el documento como blob; rechaza falta de memoria o escritura incompleta.
bool guardarEstadoPersistente() {
    if (registroLocal.overflowed()) {
        almacenamientoDisponible = false;
        return false;
    }
    String json;
    serializeJson(registroLocal, json);
    // Lectura: Limita el documento a 48 kB y compara bytes escritos; una copia incompleta no se
    // acepta.
    if (!pill::saveSnapshotBlob(memoriaPersistente, json.c_str(), json.length())) {
        almacenamientoDisponible = false;
        return false;
    }
    return true;
}

// Duplica el texto y lo entrega a una cola sin esperar; libera la copia si no hay espacio.
bool encolarMensaje(QueueHandle_t q, const String& text) {
    MensajeRed m{strdup(text.c_str())};
    if (!m.text)
        return false;
    // Lectura: Cero ticks de espera: una cola llena devuelve error y libera la copia, sin bloquear
    // el motor.
    if (xQueueSend(q, &m, 0) != pdTRUE) {
        free(m.text);
        return false;
    }
    return true;
}

// Aplica geometría y periféricos de un programa validado, conservando límites del dispositivo.
void aplicarPreferencias(JsonVariantConst plan) {
    controlador.geometry(plan["positions"] | 4);
    auto p = plan["settings"];
    preferencias.ledEnabled = p["ledEnabled"];
    preferencias.buzzerEnabled = p["buzzerEnabled"];
    preferencias.lcdEnabled = p["lcdEnabled"];
    preferencias.exitSensorEnabled = p["exitSensorEnabled"];
    preferencias.servoEnabled = p["servoEnabled"];
    preferencias.pumpEnabled = p["pumpEnabled"];
    preferencias.pumpDurationMs = p["pumpDurationMs"] | 2000;
    controlador.requireExit = preferencias.exitSensorEnabled;
}

// Procesa planes, comandos y acuses; solo instala un programa después de validarlo y persistirlo.
void procesarMensajesDeRed() {
    MensajeRed m;
    if (xQueueReceive(mensajesEntrantes, &m, 0) != pdTRUE)
        return;
    JsonDocument doc;
    // Lectura: Analiza JSON en el documento; ArduinoJson 7 copia las cadenas, por eso luego puede
    // liberarse m.text.
    auto err = deserializeJson(doc, m.text);
    free(m.text);
    if (err)
        return;
    if (doc["plan"].is<JsonObject>() &&
        !pill::planModeMatches(doc["plan"]["targetMode"].as<const char*>(), PASTILLERO_DRY_RUN)) {
        // Un cambio de modo retira horarios futuros almacenados: un plan simulado nunca se
        // reutiliza en hardware.
        if (controlador.count || !registroLocal["plan"].isNull()) {
            controlador.count = 0;
            registroLocal.remove("plan");
            if (!guardarEstadoPersistente())
                controlador.state = pill::State::Fault;
        }
        return;
    }
    // Lectura: Un acuse remoto permite retirar el resultado pendiente de NVS; no es un comando de
    // motor.
    if (doc["commandAck"].is<const char*>()) {
        registroLocal["commandResults"].remove(doc["commandAck"].as<const char*>());
        if (!guardarEstadoPersistente())
            controlador.state = pill::State::Fault;
    } else if (doc["commandId"].is<const char*>()) {
        const char* id = doc["commandId"];
        pill::Dose key;
        strlcpy(key.id, id, sizeof(key.id));
        key.scheduledAt = 1700000000000LL;
        if (strlen(id) > 36 || !pill::validDose(key) ||
            !registroLocal["commandResults"][id].isNull())
            return;
        auto command = doc["command"];
        if (!command["type"].is<const char*>() || !command["targetMode"].is<const char*>() ||
            !command["requestedAt"].is<int64_t>() || !command["expiresAt"].is<int64_t>() ||
            !command["planRevision"].is<int>())
            return;
        const char* reason =
            pill::commandDecision(command["type"], command["targetMode"], PASTILLERO_DRY_RUN,
                                  command["requestedAt"], command["expiresAt"], obtenerHoraUtcMs(),
                                  command["planRevision"], registroLocal["plan"]["revision"] | 0);
        // Otro modo deja pendiente la solicitud para el firmware al que realmente va dirigida.
        // Lectura: Mantiene pendientes los comandos aún no aplicables; no crea un rechazo
        // definitivo para otro modo.
        if (!strcmp(reason, "WAIT") || !strcmp(reason, "WRONG_MODE"))
            return;
        if (!almacenamientoDisponible || registroLocal["commandResults"].size() >= 16)
            return;
        auto result = registroLocal["commandResults"][id].to<JsonObject>();
        result["status"] = !strcmp(reason, "OK") ? "COMPLETED" : "REJECTED";
        result["reason"] = reason;
        result["executedAt"] = obtenerHoraUtcMs();
        result["requestedAt"] = command["requestedAt"];
        result["planRevision"] = registroLocal["plan"]["revision"] | 0;
        result["simulation"] = bool(PASTILLERO_DRY_RUN);
        if (!guardarEstadoPersistente())
            controlador.state = pill::State::Fault;
    } else if (doc["ack"].is<const char*>()) {
        const char* key = doc["ack"];
        if (!registroLocal["events"][key].isNull()) {
            // Lectura: Retira solo el pendiente ya confirmado por Firebase; done conserva la
            // prevención de duplicados.
            registroLocal["events"].remove(key);
            if (!guardarEstadoPersistente())
                controlador.state = pill::State::Fault;
        }
    } else if (!controlador.busy() && dispositivo.reached() &&
               doc["plan"]["revision"].as<int>() > registroLocal["plan"]["revision"].as<int>()) {
        std::unique_ptr<pill::Dose[]> parsed(new (std::nothrow) pill::Dose[96]);
        if (!parsed) {
            controlador.state = pill::State::Fault;
            return;
        }
        int count;
        if (!validarPlanRecibido(doc["plan"], parsed.get(), count)) {
            Serial.println("Plan rechazado por validacion");
            return;
        }
        registroLocal["plan"].set(doc["plan"]);
        if (!guardarEstadoPersistente()) {
            controlador.state = pill::State::Fault;
            return;
        }
        // Lectura: Después de persistir el plan válido, copia las dosis y actualiza count; no
        // cambia la dosis activa.
        aplicarPreferencias(doc["plan"]);
        memcpy(controlador.doses, parsed.get(), count * sizeof(pill::Dose));
        controlador.count = count;
    }
}

// Restaura reservas y pendientes, migra la cadena histórica y bloquea una recuperación inválida.
void restaurarMemoriaPersistente() {
    almacenamientoDisponible =
        memoriaPersistente.begin(PASTILLERO_DRY_RUN ? "pill-sim" : "pastillero", false);
    auto failed = []() {
        almacenamientoDisponible = false;
        controlador.state = pill::State::Fault;
    };
    if (!almacenamientoDisponible) { failed(); return; }
    auto source = pill::snapshotSource(memoriaPersistente);
    String stored;
    if (source == pill::SnapshotSource::Invalid) { failed(); return; }
    if (source == pill::SnapshotSource::Blob) {
        size_t length = pill::snapshotBlobSize(memoriaPersistente);
        if (!length) { failed(); return; }
        std::unique_ptr<char[]> bytes(new (std::nothrow) char[length + 1]);
        if (!bytes || !pill::readSnapshotBlob(memoriaPersistente, bytes.get(), length + 1, length)
            || !stored.concat(bytes.get(), length)) { failed(); return; }
    } else if (source == pill::SnapshotSource::LegacyString) {
        stored = memoriaPersistente.getString("snapshot", "");
        if (stored.isEmpty()) { failed(); return; }
    }
    // Una copia inválida no se normaliza ni se sobrescribe como si fuera un arranque nuevo.
    if (stored.length() && deserializeJson(registroLocal, stored)) { failed(); return; }
    if (stored.length() && (registroLocal["protocolVersion"] | 0) != 2) {
        // Copia recuperable en NVS antes de retirar solo el plan V1; done/eventos se conservan.
        // Otra clave conserva además las copias legacy-v1 antiguas sin sobrescribirlas.
        if (memoriaPersistente.putBytes("legacy-v1b", stored.c_str(), stored.length()) != stored.length()) {
            failed(); return;
        }
        registroLocal.remove("plan");
        registroLocal["protocolVersion"] = 2;
    }
    registroLocal["protocolVersion"] = 2;
    // Convierte la cadena anterior una sola vez; la conserva como copia recuperable, pero
    // el marcador impide reutilizarla automáticamente si se pierde el blob posterior.
    if (source == pill::SnapshotSource::LegacyString && !guardarEstadoPersistente()) {
        failed(); return;
    }
    if (!registroLocal["active"].isNull()) {
        pill::Dose d;
        strlcpy(d.id, registroLocal["active"]["doseId"] | "", sizeof(d.id));
        // La recuperación conserva también la pauta de origen; V1 puede no tener este campo.
        strlcpy(d.medicationId, registroLocal["active"]["medicationId"] | "", sizeof(d.medicationId));
        d.scheduledAt = registroLocal["active"]["scheduledAt"];
        d.compartment = registroLocal["active"]["compartment"];
        // Lectura: Registra interrupción conservando la reserva del ID; si no puede persistir,
        // bloquea el sistema.
        if (!dispositivo.record(d, "RECOVERY", obtenerHoraUtcMs()))
            almacenamientoDisponible = false;
        else {
            controlador.state = pill::State::Alert;
            controlador.lastEvent = "RECOVERY";
        }
    }
    if (!registroLocal["plan"].isNull() &&
        !validarPlanRecibido(registroLocal["plan"], controlador.doses, controlador.count))
        almacenamientoDisponible = false;
    if (!registroLocal["plan"].isNull() && almacenamientoDisponible)
        aplicarPreferencias(registroLocal["plan"]);
    if (!almacenamientoDisponible || falloPerifericos)
        controlador.state = pill::State::Fault;
}

// Crea una instantánea de estado y pendientes para la tarea de red cuando el motor está detenido.
void enviarTelemetria(uint32_t ms) {
    if (mensajesSalientes && dispositivo.reached() && uint32_t(ms - ultimaTelemetria) >= 2000) {
        ultimaTelemetria = ms;
        JsonDocument msg;
        msg["events"].set(registroLocal["events"]);
        msg["commandResults"].set(registroLocal["commandResults"]);
        auto state = msg["state"].to<JsonObject>();
        state["phase"] = int(controlador.state);
        state["protocolVersion"] = 2;
        state["positions"] = controlador.positions;
        state["exitDetected"] = controlador.exitDetected;
        state["pumpActive"] = indicadores.pump;
        state["servoOpen"] = indicadores.servoOpen;
        state["calibrated"] = controlador.calibrated;
        state["appliedRevision"] = registroLocal["plan"]["revision"] | 0;
        state["updatedAt"] = obtenerHoraUtcMs();
        state["simulation"] = bool(PASTILLERO_DRY_RUN);
        state["storageHealthy"] = almacenamientoDisponible;
        state["blisterPresent"] = hayBlister();
        String text;
        serializeJson(msg, text);
        encolarMensaje(mensajesSalientes, text);
    }
}


