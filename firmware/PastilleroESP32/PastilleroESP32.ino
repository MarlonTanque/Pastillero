class AdaptadorMotor : public pill::Port {
   public:
    // Lectura: Adaptador del destino: en simulación solo cambia una variable; en hardware llama
    // moveTo().
    void move(long position) override {
#if PASTILLERO_DRY_RUN
        posicionSimulada = position;
        Serial.printf("SIMULACION destino: %ld\n", position);
#else
        motor.moveTo(position);
#endif
    }
    // Lectura: En simulación el destino llega inmediatamente; en hardware exige distanceToGo()==0.
    bool reached() override {
#if PASTILLERO_DRY_RUN
        return true;
#else
        return motor.distanceToGo() == 0;
#endif
    }
    // Lectura: Busca el ID en done: retransmitir el plan no vuelve a habilitar una dosis consumida.
    bool handled(const char* id) override {
        return !registroLocal["done"][id].isNull();
    }
    // Lectura: Construye un evento con clave estable y guarda la reserva antes de devolver éxito.
    bool record(const pill::Dose& d, const char* kind, int64_t actual) override {
        bool starting = strcmp(kind, "STARTED") == 0;
        if (!almacenamientoDisponible || registroLocal["events"].size() >= 64 ||
            (starting &&
             // Lectura: Reserva margen para terminar/recuperar una entrega; una memoria llena
             // requiere mantenimiento, Lectura: no borrar IDs.
             (registroLocal["events"].size() > 60 || registroLocal["done"].size() >= 256)))
            return false;
        // Lectura: La misma dosis y tipo producen la misma clave; SIM separa eventos de prueba de
        // los físicos.
        String key = String(d.id) + (PASTILLERO_DRY_RUN ? "-SIM-" : "-") + kind;
        auto e = registroLocal["events"][key].to<JsonObject>();
        pill::writeDoseEvent(e, d, kind, actual, bool(PASTILLERO_DRY_RUN));
        // Lectura: Marca durable de consumo, incluso si el evento sigue esperando Internet.
        pill::reserveDoseId(registroLocal, d);
        if (starting)
            // Lectura: STARTED deja evidencia de entrega en curso para detectar un reinicio
            // interrumpido.
            registroLocal["active"].set(e);
        else
            // Lectura: Al terminar con un evento final retira la entrega activa, conservando el ID
            // consumido.
            registroLocal.remove("active");
        if (!guardarEstadoPersistente())
            return false;
        Serial.printf("Evento durable: %s\n", kind);
        return true;
    }
} dispositivo;
pill::Controller controlador(dispositivo);

